# Copie para .env e preencha. Variáveis EXPO_PUBLIC_* vão dentro do app: não coloque segredos de verdade aqui.

# Endpoint PHP de upload de imagem (o mesmo do app web)
EXPO_PUBLIC_API_UPLOAD_URL=https://apptractus.com.br/api/upload-profile-image.php
EXPO_PUBLIC_API_BASE_URL=https://apptractus.com.br/api

# App do OneSignal (o mesmo do app web)
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# Chave usada pelos endpoints de push em PHP (hoje também está exposta no bundle do web)
EXPO_PUBLIC_PUSH_SECRET=
